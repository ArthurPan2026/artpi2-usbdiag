if(NOT DEFINED INPUT_FILE OR NOT EXISTS "${INPUT_FILE}")
    message(FATAL_ERROR "Cannot hash missing file: ${INPUT_FILE}")
endif()
if(NOT DEFINED OUTPUT_FILE)
    message(FATAL_ERROR "OUTPUT_FILE is required")
endif()
file(SHA256 "${INPUT_FILE}" IMAGE_SHA256)
get_filename_component(IMAGE_NAME "${INPUT_FILE}" NAME)
file(WRITE "${OUTPUT_FILE}" "${IMAGE_SHA256}  ${IMAGE_NAME}\n")
