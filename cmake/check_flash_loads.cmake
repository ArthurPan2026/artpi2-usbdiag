if(NOT EXISTS "${ELF}" OR NOT EXISTS "${READELF}")
    message(FATAL_ERROR "ELF/readelf missing for reserved Flash verification")
endif()
execute_process(COMMAND "${READELF}" -W -l "${ELF}"
    RESULT_VARIABLE status OUTPUT_VARIABLE headers ERROR_VARIABLE errors)
if(NOT status EQUAL 0)
    message(FATAL_ERROR "readelf failed: ${errors}")
endif()
string(REPLACE "\n" ";" lines "${headers}")
set(loads 0)
foreach(line IN LISTS lines)
    if(line MATCHES "^[ \t]*LOAD[ \t]+0x[0-9a-fA-F]+[ \t]+(0x[0-9a-fA-F]+)[ \t]+(0x[0-9a-fA-F]+)[ \t]+(0x[0-9a-fA-F]+)[ \t]+(0x[0-9a-fA-F]+)")
        math(EXPR virtual "${CMAKE_MATCH_1}")
        math(EXPR physical "${CMAKE_MATCH_2}")
        math(EXPR physical_end "${CMAKE_MATCH_2}+${CMAKE_MATCH_3}")
        math(EXPR virtual_end "${CMAKE_MATCH_1}+${CMAKE_MATCH_4}")
        math(EXPR loads "${loads}+1")
        if((physical LESS 134283264 AND physical_end GREATER 134266880) OR
           (virtual LESS 134283264 AND virtual_end GREATER 134266880))
            message(FATAL_ERROR "ELF LOAD overlaps WiFi NV 0x0800C000..0x08010000: ${line}")
        endif()
        if(line MATCHES "[ \t]RWE[ \t]")
            message(FATAL_ERROR "ELF contains an RWX load segment: ${line}")
        endif()
    endif()
endforeach()
if(loads EQUAL 0)
    message(FATAL_ERROR "No ELF load segments parsed; cannot certify reserved Flash")
endif()
message(STATUS "${loads} ELF load segments verified: no WiFi NV overlap or RWX")
