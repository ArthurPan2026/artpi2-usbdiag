{
  "version": 3,
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/../gcc-arm-none-eabi.cmake",
      "cacheVariables": {}
    },
    {
      "name": "Debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "RTTHREAD_PROFILE": "performance",
        "RTTHREAD_ALLOCATOR": "memheap",
        "LVGL_PROFILE": "performance",
        "LVGL_DRAW_DMA2D": "ON"
      }
    },
    {
      "name": "Release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RTTHREAD_PROFILE": "release",
        "RTTHREAD_ALLOCATOR": "memheap",
        "LVGL_PROFILE": "release",
        "LVGL_DRAW_DMA2D": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Debug",
      "configurePreset": "Debug"
    },
    {
      "name": "Release",
      "configurePreset": "Release"
    }
  ]
}
