menuconfig PKG_USING_WATCHDOG_CRASHLOG
    bool "watchdog_crashlog: portable fault and event record core"
    default n
    help
      Add the portable C99 watchdog record core. Hardware watchdog setup,
      retained-memory placement, CPU fault entry, and product flash logging
      remain the responsibility of the BSP or application.

if PKG_USING_WATCHDOG_CRASHLOG

    config PKG_WATCHDOG_CRASHLOG_PATH
        string
        default "/packages/peripherals/watchdog_crashlog"

    choice
        prompt "Version"
        default PKG_USING_WATCHDOG_CRASHLOG_V010
        help
          Select a fixed watchdog_crashlog package version.

        config PKG_USING_WATCHDOG_CRASHLOG_V010
            bool "v0.1.0"
    endchoice

    config PKG_WATCHDOG_CRASHLOG_VER
        string
        default "v0.1.0" if PKG_USING_WATCHDOG_CRASHLOG_V010

    config PKG_USING_WATCHDOG_CRASHLOG_RTT_SUPERVISOR
        bool "Optional RT-Thread single-feeder supervisor adapter"
        default n
        help
          Build the RT-Thread thread adapter. The consumer supplies health
          policy and the actual hardware watchdog feed callback.

endif
