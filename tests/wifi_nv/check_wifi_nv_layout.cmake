if(NOT DEFINED REPO_ROOT)
    message(FATAL_ERROR "Set REPO_ROOT to the firmware repository root")
endif()

file(READ "${REPO_ROOT}/Boot/stm32h7r7xx_flash.ld" linker_script)
file(READ "${REPO_ROOT}/Appli/User/wifi/include/wifi_nv_layout.h" layout_header)

if(NOT linker_script MATCHES "__FLASH_BEGIN[ \t]*=[ \t]*0x08000000")
    message(FATAL_ERROR "Boot flash origin is not 0x08000000")
endif()
if(NOT linker_script MATCHES "__FLASH_SIZE[ \t]*=[ \t]*0x0000C000")
    message(FATAL_ERROR "Boot flash must stop at the start of WiFi NV sectors")
endif()
if(NOT layout_header MATCHES "WIFI_NV_FLASH_BASE_ADDRESS[ \t]+0x0800C000")
    message(FATAL_ERROR "WiFi NV base does not match sectors 6 and 7")
endif()
if(NOT layout_header MATCHES "WIFI_NV_FLASH_SECTOR_SIZE[ \t]+8192U")
    message(FATAL_ERROR "WiFi NV sector size must be 8 KiB")
endif()
if(NOT layout_header MATCHES "WIFI_NV_FLASH_SECTOR_COUNT[ \t]+2U")
    message(FATAL_ERROR "WiFi NV reservation must have two sectors")
endif()

message(STATUS "WiFi NV and Boot flash ranges do not overlap")
